      "text": "namespace:\nkubectl create ns sadaf-resource\n\npod.yaml\napiVersion: v1\nkind: Pod\nmetadata:\n  name: resource-pod\n  namespace: sadaf-resource\nspec:\n  containers:\n  - name: app\n    image: busybox\n    command: [\"sh\",\"-c\",sleep 3600]\n    resources:\n      requests:\n        cpu: \"100m\"\n        memory: \"64Mi\"\n      limits:\n        cpu: \"200m\"\n        memory: \"128Mi\"",
