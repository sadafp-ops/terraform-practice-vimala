      "seed": 573075520,
      "version": 327,
      "versionNonce": 1063991360,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1766160613113,
      "link": null,
      "locked": false,
      "text": "Required(HARD RULE)\npod will not run if condition is not met.\nrequiredDuringSchedulingIgnoreDuringExecution\n\nPreferred(SOFT RULE)\npod tries but can ignore if needed\npreferredDuringSchedilingIgnoreDuringExecution\n\n\nkubectl label kcna-cluster-worker app=frontend\nkubectl get nodes --show-labels\n\npod-affinity yaml manifest file",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Required(HARD RULE)\npod will not run if condition is not met.\nrequiredDuringSchedulingIgnoreDuringExecution\n\nPreferred(SOFT RULE)\npod tries but can ignore if needed\npreferredDuringSchedilingIgnoreDuringExecution\n\n\nkubectl label kcna-cluster-worker app=frontend\nkubectl get nodes --show-labels\n\npod-affinity yaml manifest file",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5Ih1MEenUSJhMZw1VNs9t",
      "type": "text",
      "x": 699.95703125,
      "y": 9239.96484375,
      "width": 786.6036987304688,
      "height": 385,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
