      "isDeleted": false,
      "boundElements": null,
      "updated": 1766488277172,
      "link": null,
      "locked": false,
      "text": "CPU - request will be guaranteed but the limit is throttle.\nMemory - request is guaranteed while limit is OOMKILLED.\nSo Memory limit cross = POD KILLED\nCPU limit cross = it will be slow but not killed",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CPU - request will be guaranteed but the limit is throttle.\nMemory - request is guaranteed while limit is OOMKILLED.\nSo Memory limit cross = POD KILLED\nCPU limit cross = it will be slow but not killed",
      "autoResize": true,
      "lineHeight": 1.25
    },
