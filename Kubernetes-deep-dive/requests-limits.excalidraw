    {
      "id": "dJZGeCZcqMitm0kctG-oP",
      "type": "text",
      "x": 682.75,
      "y": 8724.48046875,
      "width": 649.8796997070312,
      "height": 455,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
